# Base URL the frontend calls for the API, including the /api prefix.
# In production (Vercel), set this to the deployed Render backend's URL,
# e.g. https://your-app.onrender.com/api — no trailing slash.
#
# Read via import.meta.env.VITE_API_BASE_URL in src/services/api.js. If
# this is left unset in a Vercel deployment, the build falls back to
# http://localhost:5000/api (baked into the built bundle at build time,
# same as any Vite env var), which will not work in production — every API
# call will silently fail. Must be set explicitly in Vercel's dashboard.
VITE_API_BASE_URL=http://localhost:5000/api
