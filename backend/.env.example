# Stage 12: this file lists every environment variable the backend reads.
# Copy to .env for local dev (cp backend/.env.example backend/.env) and fill
# in real values. In production (Render), set these in the service's
# Environment tab instead — do not commit real values anywhere.

# development | production. Also controls whether a missing required var
# below (MONGODB_URI, JWT_SECRET) crashes the process on startup (production)
# or just logs a warning (any other value, for local-dev convenience).
NODE_ENV=development

# Render assigns this dynamically at runtime and overrides whatever is set
# here — this default is only ever used for local dev.
PORT=5000

# MongoDB connection string. No hardcoded fallback exists anywhere in the
# code (config/db.js throws immediately if this is unset) — in production,
# point this at your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/inter_office_memo

# JWT signing secret — generate your own random string (e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`),
# never commit a real one. No hardcoded fallback exists anywhere in the code.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The deployed frontend's origin, used for CORS — in production, the exact
# Vercel URL (e.g. https://your-app.vercel.app), no trailing slash. Falls
# back to the local Vite dev server, never to a wildcard.
CLIENT_URL=http://localhost:5173

# Supabase Storage (Stage 8b) — used server-side only for memo attachments.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be sent to the frontend or committed.
# None of the three vars below have a hardcoded fallback in the code — all
# three must be set explicitly, in every environment, or attachment
# upload/download/delete will fail with a clear error naming what's missing.
#
# Manual setup required in the Supabase dashboard before attachments work:
#   1. Create a Storage bucket named exactly as SUPABASE_BUCKET below
#      (e.g. "memo-attachments" — lowercase letters, numbers, and hyphens
#      only, no spaces).
#   2. Leave "Public bucket" OFF — it must be private. This app's backend
#      is the only intended access path; the service role key it uses
#      bypasses Row Level Security entirely, so a public bucket would let
#      anyone read every organization's attachments directly, bypassing
#      every authorization check this app enforces.
#   3. Copy the Project URL and the service_role secret key (Project
#      Settings -> API) into SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below
#      — the service_role key, not the anon/public key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=memo attachments
