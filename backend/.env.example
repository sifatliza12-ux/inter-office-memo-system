NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/inter_office_memo

# JWT signing secret — generate your own random string, never commit a real one
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL of the frontend app, used for CORS configuration
CLIENT_URL=http://localhost:5173

# Supabase Storage (Stage 8b) — used server-side only for memo attachments.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be sent to the frontend or committed.
#
# Manual setup required in the Supabase dashboard before attachments work:
#   1. Create a Storage bucket named exactly as SUPABASE_BUCKET below
#      (default: "memo-attachments").
#   2. Leave "Public bucket" OFF — it must be private. This app's backend
#      is the only intended access path; the service role key it uses
#      bypasses Row Level Security entirely, so a public bucket would let
#      anyone read every organization's attachments directly, bypassing
#      every authorization check this app enforces.
#   3. Copy the Project URL and the service_role secret key (Project
#      Settings -> API) into SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below
#      — the service_role key, not the anon/public key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=memo attachments
